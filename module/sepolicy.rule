allow hal_audio_default ashmem_device chr_file { open read write ioctl map getattr }
allow hal_audio_default hal_audio_default file { open read write create getattr setattr map unlink }
allow hal_audio_default memfd file { open read write getattr setattr map }
allow hal_audio_default tmpfs file { open read write create getattr setattr map unlink }
# The effect queues are memfds when falling back from ashmem; ls -LZ on /proc/<hal>/fd
# shows the target inode label is u:object_r:tmpfs:s0 (the symlink itself is hal_audio_default).
# audioserver maps those queues when it attaches the effect, so it needs access to both labels -
# without this rule the queue is refused ("handleSetConfig ... Line: 205 Failed" right after open,
# then "invalid efGroup" on every buffer) under dontaudit.
allow audioserver hal_audio_default file { read write open map getattr ioctl }
allow audioserver tmpfs file { read write open map getattr ioctl }
